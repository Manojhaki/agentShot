# agent-backend/.env
# Uses a local Ollama instance (free, no API key needed). Install from
# https://ollama.com and run: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
PORT=4000

# Optional: absolute path to a SQLite database
# AGENTSHOT_DB_PATH=C:/path/to/agentshot.sqlite
# WEB_ORIGIN=http://localhost:3001
