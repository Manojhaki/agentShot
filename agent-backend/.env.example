# agent-backend/.env
# Uses a local Ollama instance (free, no API key needed). Install from
# https://ollama.com and run: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
PORT=4000

# Optional: absolute path to a SQLite database
# AGENTSHOT_DB_PATH=C:/path/to/agentshot.sqlite
# WEB_ORIGIN=http://localhost:3001

# OpenTelemetry: file (default), otlp, both, or none
AGENTSHOT_OTEL_EXPORTER=file
# Local viewer: npm.cmd run traces -> http://127.0.0.1:4310
# AGENTSHOT_TELEMETRY_DIR=C:/path/to/local/traces
# OTEL_SDK_DISABLED=true

# Opt-in recording of prompts, replies, tool payloads and provider-returned thinking.
# Raw text may contain personal data. Structured session/address fields are redacted.
OTEL_CAPTURE_CONTENT=false
OTEL_CONTENT_MAX_BYTES=8192

# Only for a model supporting thinking; omit to keep the model's default.
# OLLAMA_THINK=true

# Optional OTLP HTTP/JSON export (e.g. local Jaeger)
# AGENTSHOT_OTEL_EXPORTER=both
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
